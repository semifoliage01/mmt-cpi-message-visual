{
  "_version": "1.58.0",
  "sap.app": {
    "id": "autotestcases",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.11.4",
      "toolsId": "f0d9b953-0695-4ec0-bbdc-f2b8e7f9f116"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/catalog/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/metadata.xml",
          "odataVersion": "4.0"
        }
      },
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.139.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ushell": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "autotestcases.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "autoTestCasesList",
          "target": "autoTestCasesList"
        },
        {
          "pattern": "autoTestCases({key}):?query:",
          "name": "autoTestCasesObjectPage",
          "target": ["autoTestCasesList","autoTestCasesObjectPage"]
        },
        {
          "pattern": "targetSysConfig({key}):?query:",
          "name": "targetSysConfigObjectPage",
          "target": ["autoTestCasesList","targetSysConfigObjectPage"]
        }
      ],
      "targets": {
        "autoTestCasesList": {
          "type": "Component",
          "id": "autoTestCasesList",
          "name": "sap.fe.templates.ListReport",
          "controlAggregation": "beginColumnPages",
          "contextPattern": "",
          "options": {
            "settings": {
              "contextPath": "/autoTestCases",
              "views": {
                "paths": [
                  {
                    "key": "tab1",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#autoTestCases"
                  },
                  {
                    "key": "tab2",
                    "contextPath": "/targetSysConfig",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#targetSysConfig"
                  }
                ]
              },
              "variantManagement": "Page",
              "navigation": {
                "autoTestCases": {
                  "detail": {
                    "route": "autoTestCasesObjectPage"
                  }
                },
                "targetSysConfig": {
                  "detail": {
                    "route": "targetSysConfigObjectPage"
                  }
                }
              }
            }
          }
        },
        "autoTestCasesObjectPage": {
          "type": "Component",
          "id": "autoTestCasesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "controlAggregation": "midColumnPages",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/autoTestCases"
            }
          }
        },

        "targetSysConfigObjectPage": {
          "type": "Component",
          "id": "targetSysConfigObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "controlAggregation": "midColumnPages",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/autoTestCases"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
