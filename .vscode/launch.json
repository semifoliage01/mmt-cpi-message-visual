            "request": "launch",
            "runtimeExecutable": "npx",
            "cwd": "${workspaceFolder}/public/flowlogsample",
            "windows": {
                "runtimeExecutable": "npx.cmd"
            },
            "runtimeArgs": [
                "fiori",
                "run"
            ],
            "args": [
                "--open",
                "test/flpSandbox.html#flowlogsample-tile"
